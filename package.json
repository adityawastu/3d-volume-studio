{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "format:php": "php vendor/bin/pint",
    "format:php:check": "php vendor/bin/pint --test",
    "fix": "npm run format && npm run format:php",
    "check": "npm run format:check && npm run format:php:check"
  },
  "devDependencies": {
    "@prettier/plugin-php": "^0.25.0",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.3",
    "laravel-vite-plugin": "^3.1",
    "prettier": "^3.9.9",
    "prettier-plugin-blade": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.0"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2"
  }
}
